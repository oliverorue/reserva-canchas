        {% for r in reservations %}
          <li>
            <div>
              <strong>{{ r.start_time.strftime('%H:%M') }} – {{ r.end_time.strftime('%H:%M') }}</strong>
              <span>{{ r.person_name }}</span>
            </div>
            <form method="post" action="/reservations/{{ r.id }}/cancel">
              <input type="hidden" name="court_id" value="{{ court.id }}">
              <input type="hidden" name="date" value="{{ day.strftime('%Y-%m-%d') }}">
              <button type="submit" class="btn btn-danger" onclick="return confirm('¿Cancelar esta reserva?')">Cancelar</button>
