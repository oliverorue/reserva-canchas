          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="muted">No hay reservas para esta fecha.</p>
    {% endif %}
  </section>

  <section class="card">
    <h2>Nueva reserva</h2>
    <form method="post" action="/reservations" class="reservation-form">
      <input type="hidden" name="court_id" value="{{ court.id }}">
      <input type="hidden" name="date" value="{{ day.strftime('%Y-%m-%d') }}">
      <label>
        Nombre
        <input type="text" name="person_name" required minlength="1" maxlength="100">
      </label>
      <label>
        Hora de inicio
        <input type="time" name="start_time" required>
      </label>
      <label>
        Hora de fin
        <input type="time" name="end_time" required>
      </label>
      <button type="submit" class="btn btn-primary">Reservar</button>
    </form>
  </section>
</div>
{% endblock %}
